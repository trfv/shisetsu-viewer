{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shisetsu-mcp-server",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-02-28",
  // global_fetch_strictly_public: CIMD（URL 形式の client_id）のメタデータ取得に OAuthProvider が要求する
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    // 秘密ではないので Secret ではなく vars に置く（値を確かめられるように）。
    // AUTH0_DOMAIN はカスタムドメイン。api の resolveRole が issuer をこの値で検証するので、
    // packages/api/wrangler.jsonc の AUTH0_DOMAIN と一致させる。
    "AUTH0_DOMAIN": "auth.shisetsudb.com",
    "AUTH0_AUDIENCE": "https://api.shisetsudb.com/",
  },
  // Auth0 の Regular Web Application の値。ここに無い Secret があると deploy が止まる。
  "secrets": { "required": ["AUTH0_CLIENT_ID", "AUTH0_CLIENT_SECRET"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  // Required by @cloudflare/workers-oauth-provider for OAuth state (clients, grants, tokens)
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "64528661f5e74163a2d6a80f60d40749" }],
  // PR 3-1 で作成した D1（api と同一 DB）を直バインドし、GraphQL を介さず読む
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shisetsu-db",
      "database_id": "353bd30e-d421-460f-821a-018fd05a455c",
    },
  ],
}
