{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // worker/ は Workers ランタイムの型で別途検査する（worker/tsconfig.json）。
  // ここに含めると Request / Response / caches の DOM 型と衝突する。
  "exclude": ["node_modules", "worker", "worker-configuration.d.ts"]
}
