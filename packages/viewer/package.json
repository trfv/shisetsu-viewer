{
  "name": "@shisetsu-viewer/viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "date-fns": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "msw": "2.15.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.150.0"
  },
  "scripts": {
    "start": "vite --port 3000",
    "build": "npm run typecheck && vite build",
    "serve": "vite preview --port 3000",
    "typecheck": "tsc && wrangler types && tsc -p worker",
    "test": "TZ=Asia/Tokyo vitest",
    "test:ci": "TZ=Asia/Tokyo vitest --run",
    "test:unit": "TZ=Asia/Tokyo vitest --run --reporter=verbose",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:integration": "TZ=Asia/Tokyo vitest --run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:ci && npm run test:e2e",
    "coverage": "TZ=Asia/Tokyo vitest run --coverage",
    "coverage:open": "TZ=Asia/Tokyo vitest run --coverage && open coverage/index.html",
    "deploy": "wrangler deploy",
    "deploy:versions": "wrangler versions upload",
    "preview": "wrangler dev"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
