# ローカル開発用の Secret。`.dev.vars` にコピーして値を入れる。
# wrangler と @cloudflare/vite-plugin が dev 実行時に読み込む。`.dev.vars` は gitignore 済み。
#
# redirect_uri はリクエストのオリジンから導出されるため、オリジンの設定は不要である。
# ローカルなら http://localhost:3000/auth/callback が使われる。
# この URI を Google Cloud Console の承認済みリダイレクト URI に登録しておくこと
# （Google はワイルドカードを受け付けないため、本番・preview・localhost を個別に登録する）。

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# api 向け JWT の署名鍵。秘密 JWK の配列を JSON 1 行で。先頭が署名鍵で kid が必須。
# ローカル検証用は本番と別の鍵にする。生成:
#   node -e 'const j=await import("jose");const p=await j.generateKeyPair("ES256",{extractable:true});const k=await j.exportJWK(p.privateKey);k.kid="local";k.alg="ES256";k.use="sig";console.log(JSON.stringify([k]))'
AUTH_SIGNING_KEYS=[]
