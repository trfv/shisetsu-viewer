{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shisetsu-viewer",
  "compatibility_date": "2026-02-28",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "app.shisetsudb.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // 静的アセットは Worker を経由させない（課金対象外・無制限）。
    "run_worker_first": ["/auth/*", "/api/*"],
  },
  "vars": {
    // packages/api/wrangler.jsonc の AUTH0_DOMAIN と一致させる（api は issuer をこの値で検証する）。
    "AUTH0_DOMAIN": "auth.shisetsudb.com",
    "AUTH0_AUDIENCE": "https://api.shisetsudb.com/",
  },
  // 値は `wrangler versions secret put <NAME>` で入れる。ここに無い Secret があると deploy が止まる。
  // AUTH0_CLIENT_* は Auth0 の Regular Web Application の値。
  "secrets": { "required": ["AUTH0_CLIENT_ID", "AUTH0_CLIENT_SECRET", "SESSION_KEYS"] },
  "services": [{ "binding": "API", "service": "shisetsu-api" }],
  // api 側の RATE_LIMITER は別 Worker のため共有できない。
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      // period は 10 または 60 のみ指定可能
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "dev": {
    "port": 3000,
  },
}
