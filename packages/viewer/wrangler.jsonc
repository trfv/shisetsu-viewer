{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shisetsu-viewer",
  "compatibility_date": "2026-02-28",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // 静的アセットは Worker を経由しない（課金対象外・無制限）。BFF が要る 2 経路だけ先に走らせる。
    "run_worker_first": ["/auth/*", "/api/*"],
  },
  "vars": {
    // カスタムドメイン。packages/api/wrangler.jsonc の AUTH0_DOMAIN と一致させる
    // （api は issuer をこの値で検証する）。
    "AUTH0_DOMAIN": "auth.shisetsudb.com",
    "AUTH0_AUDIENCE": "https://api.shisetsudb.com/",
  },
  "services": [{ "binding": "API", "service": "shisetsu-api" }],
  // ログイン経路の総当たり対策。api 側の RATE_LIMITER は別 Worker のため共有できない。
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      // period は 10 または 60 のみ指定可能
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "dev": {
    "port": 3000,
  },
}
