{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shisetsu-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // api.shisetsudb.com は旧 Hasura の A レコードが占有している
  "routes": [{ "pattern": "d1-api.shisetsudb.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // ここに無い Secret があると deploy が止まる
  "secrets": { "required": ["ADMIN_API_KEY"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shisetsu-db",
      "database_id": "353bd30e-d421-460f-821a-018fd05a455c",
      "migrations_dir": "migrations",
    },
  ],
  // クエリを変えればエッジキャッシュを迂回できるので、D1 読み取り無料枠の枯渇を防ぐ
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      // period は 10 または 60 のみ指定可能
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "vars": {
    // trfv.jp.auth0.com にしない。実トークンの iss / jwks_uri はカスタムドメインで、全トークンが弾かれる
    "AUTH0_DOMAIN": "auth.shisetsudb.com",
    // 末尾スラッシュ付き（OIDC_AUDIENCE とは違う）
    "AUTH0_AUDIENCE": "https://api.shisetsudb.com/",
    "GITHUB_REPOSITORY": "trfv/shisetsu-viewer",
    "OIDC_AUDIENCE": "https://api.shisetsudb.com",
  },
}
